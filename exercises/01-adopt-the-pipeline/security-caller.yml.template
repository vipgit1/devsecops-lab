name: security

on:
  push:
    branches: [ main ]
  pull_request:
  workflow_dispatch:

permissions:
  actions: read
  contents: read
  security-events: write
  pull-requests: write

jobs:
  scan:
    uses: vipgit1/security-templates/.github/workflows/snyk-scan.yml@<TEMPLATE_SHA>
    with:
      severity-threshold: high
      enforce-gate: false
    secrets:
      SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}
